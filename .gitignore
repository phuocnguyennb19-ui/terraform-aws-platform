# Terraform working state and plans stay local. terraform/.terraform.lock.hcl is
# committed on purpose: it pins provider versions and checksums for CI.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
tfplan-*
plan-*.txt
deploy-*.json
helm-values/
*_override.tf
crash.log
crash.*.log
.terraformrc
terraform.rc

# Credentials never belong in the repository; CI authenticates through OIDC.
*.pem
*.key
.aws/
credentials

# Environment inputs are terraform/<env>/config.yaml — YAML, committed on purpose.
*.tfvars
*.tfvars.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
