# Values only. Nothing Terraform produces belongs here — if a deploy is ever run
# from inside this directory, its working state, plans and clones stay local.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan
tfplan-*
/tf/
/.tfmodule/

# Variable files may carry account-specific or sensitive values. Environment
# inputs are environments/<env>/config.yaml — YAML, committed on purpose.
*.tfvars
*.tfvars.json

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
