# ===========================================================================
# terraform.tfvars.example
#
# Copy into an environment directory and edit:
#
#   cp terraform.tfvars.example environments/dev/terraform.tfvars
#
# Every variable is documented in environments/<env>/variables.tf. The three
# committed files under environments/*/terraform.tfvars are working examples of
# a cost-optimised dev, a production-shaped staging, and a hardened prod.
#
# ---------------------------------------------------------------------------
# NO SECRET BELONGS IN THIS FILE, OR IN ANY .tfvars FILE.
#
# A tfvars file is plain text in Git, and anything Terraform reads is written
# into the state file in plaintext. The platform is built so there is nothing to
# put here:
#
#   Database password  Generated by AWS into Secrets Manager. No module in this
#                      platform accepts a password variable; there is nowhere to
#                      type one. Read the secret's ARN from the
#                      rds_master_user_secret_arn output.
#
#   Redis AUTH token   Referenced by Secrets Manager ARN, never by value.
#
#   TLS certificates   Issued and renewed by ACM. Private keys never leave AWS.
#
#   AWS credentials    Supplied by the environment — an assumed role, an
#                      instance profile, or OIDC in CI. Never a variable.
#
# See README "How secrets are handled".
# ===========================================================================

# ---------------------------------------------------------------------------
# Identity — required
# ---------------------------------------------------------------------------

environment = "dev"              # dev | staging | prod
region      = "ap-southeast-1"
project     = "platform"

owner       = "platform-engineering"
cost_center = "engineering"

# Assume a per-environment role instead of using long-lived keys.
# assume_role_arn = "arn:aws:iam::111122223333:role/terraform-platform-dev"

# Cap what any role this stack creates can ever be granted.
# permissions_boundary_arn = "arn:aws:iam::111122223333:policy/platform-boundary"

# ---------------------------------------------------------------------------
# Foundation — required
#
# Keep environment CIDRs non-overlapping (10.10 / 10.20 / 10.30). Overlapping
# ranges make VPC peering and Transit Gateway attachment impossible later, and
# the only fix is re-addressing a live environment.
# ---------------------------------------------------------------------------

vpc_cidr = "10.10.0.0/16"
az_count = 3

# Pin the zones in staging and prod. Without this, a change in the order the
# region reports its zones renumbers every subnet — which Terraform plans as a
# destroy and recreate of the entire network.
# azs = ["ap-southeast-1a", "ap-southeast-1b", "ap-southeast-1c"]

# One NAT gateway instead of one per AZ. Cheaper; makes egress a single-AZ
# dependency. Forced to false when environment = "prod".
single_nat_gateway = true

enable_flow_logs        = true
flow_log_retention_days = 30

# Interface endpoints keep ECR/CloudWatch/SSM traffic off the NAT gateway.
# Billed hourly per AZ, so name only what you use.
# interface_endpoints = ["ecr.api", "ecr.dkr", "logs", "ssm", "ssmmessages", "ec2messages"]

# ---------------------------------------------------------------------------
# Workload toggles — deploy only what this environment needs
#
#   Scenario A (base infrastructure)  every toggle false
#   Scenario B (EKS)                  enable_eks
#   Scenario C (EC2)                  enable_ec2
#   Scenario D (RDS)                  enable_rds
#   Scenario E (full platform)        all of them
# ---------------------------------------------------------------------------

enable_alb         = false
enable_eks         = false
enable_ec2         = false
enable_rds         = false
enable_elasticache = false
enable_lambda      = false
enable_ecr         = false
enable_route53     = false
enable_acm         = false   # requires enable_route53
enable_bastion_sg  = false   # prefer Session Manager

# ---------------------------------------------------------------------------
# DNS and certificates — required when enable_route53 is true
# ---------------------------------------------------------------------------

# domain_name     = "example.com"
# create_dns_zone = false        # false looks the zone up; true creates it
# app_hostname    = "api"        # null publishes at the zone apex
# certificate_sans = []

# ---------------------------------------------------------------------------
# ALB
# ---------------------------------------------------------------------------

alb_internal                   = false
alb_ingress_cidrs              = ["0.0.0.0/0"]
application_port               = 8080
health_check_path              = "/healthz"
alb_access_logs_retention_days = 90

# ---------------------------------------------------------------------------
# EKS
# ---------------------------------------------------------------------------

kubernetes_version = "1.31"

# Forced to false when environment = "prod".
eks_public_api_access = false
eks_public_api_cidrs  = []   # 0.0.0.0/0 is rejected by a validation block

eks_node_groups = {
  general = {
    instance_types = ["t3.large"]
    capacity_type  = "ON_DEMAND"
    min_size       = 2
    max_size       = 6
    desired_size   = 2
    disk_size      = 50
  }
}

# IAM roles assumable by Kubernetes service accounts.
# eks_irsa_roles = {
#   external_dns = {
#     description                = "external-dns manages Route53 records"
#     namespace_service_accounts = ["kube-system:external-dns"]
#     managed_policy_arns        = []
#     inline_policy              = null
#   }
# }

# ---------------------------------------------------------------------------
# EC2
#
# subnet_index selects a private subnet from the foundation by position, so an
# environment never names a subnet ID that does not exist until apply time.
# ---------------------------------------------------------------------------

# ec2_instances = {
#   app = {
#     subnet_index     = 0
#     instance_type    = "t3.medium"
#     root_volume_size = 30
#   }
# }

# ---------------------------------------------------------------------------
# RDS
#
# family and major_engine_version must match engine_version's major, or the
# apply fails at AWS rather than at plan time.
#
# In prod, multi_az / deletion protection / a final snapshot / >= 30 days of
# backups are forced on regardless of what is set here.
# ---------------------------------------------------------------------------

rds_engine                = "postgres"   # postgres | mysql
rds_engine_version        = "16.4"
rds_family                = "postgres16"
rds_major_engine_version  = "16"
rds_instance_class        = "db.t4g.medium"
rds_allocated_storage     = 50
rds_max_allocated_storage = 200
rds_multi_az              = false
rds_backup_retention_period = 7
rds_database_name         = "appdb"
rds_username              = "dbadmin"
# There is no rds_password. AWS generates it into Secrets Manager.

# ---------------------------------------------------------------------------
# ElastiCache
# ---------------------------------------------------------------------------

elasticache_node_type              = "cache.t4g.micro"
elasticache_engine_version         = "7.1"
elasticache_parameter_group_family = "redis7"
elasticache_num_cache_clusters     = 1   # floored at 2 in prod

# Reference the AUTH token by secret ARN. Never paste the token itself.
# elasticache_auth_token_secret_arn = "arn:aws:secretsmanager:ap-southeast-1:111122223333:secret:dev/redis/auth-AbCdEf"

# ---------------------------------------------------------------------------
# ECR
#
# use_name_prefix = false shares one repository across environments, which is
# what image promotion by digest requires.
# ---------------------------------------------------------------------------

ecr_use_name_prefix = false

ecr_repositories = {
  api = {
    image_tag_mutability = "IMMUTABLE"
    scan_on_push         = true
    untagged_expiry_days = 7
    keep_tagged_count    = 30
  }
}

# ---------------------------------------------------------------------------
# Lambda
# ---------------------------------------------------------------------------

# lambda_functions = {
#   processor = {
#     handler      = "index.handler"
#     runtime      = "python3.12"
#     source_path  = "../../src/processor"
#     vpc_attached = true        # needed to reach RDS or ElastiCache
#     memory_size  = 512
#     timeout      = 30
#   }
# }

# ---------------------------------------------------------------------------
# Security and observability
# ---------------------------------------------------------------------------

# Administrative ranges for the bastion. 0.0.0.0/0 is rejected.
bastion_allowed_cidrs = []

log_retention_days     = 30   # floored at 90 in prod
create_alarm_dashboard = false

# An alarm with no subscription is a dashboard widget. An email subscription
# stays PENDING_CONFIRMATION until someone clicks the link, and Terraform
# reports success either way — https to an on-call system confirms itself.
alarm_subscriptions = {
  # oncall = { protocol = "https", endpoint = "https://events.pagerduty.com/integration/REPLACE/enqueue" }
}
